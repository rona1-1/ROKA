# نسخة المرجع — انسخها إلى .env واملأ القيم الحقيقية.
# لا تضع القيم الحقيقية في هذا الملف أبدًا.

# قاعدة Turso (إلزامي)
TURSO_DATABASE_URL=libsql://<db-name>-<org>.turso.io
TURSO_AUTH_TOKEN=<Turso token>

# حدود قابلة للضبط
MAX_SOURCES=10
SOURCE_MAX_MB=200
OUTPUT_MAX_MB=150
MAX_TOTAL_DURATION_SEC=600
FFMPEG_PRESET=medium
