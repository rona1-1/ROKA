# نسخة المرجع — انسخها إلى .env.local واملأ القيم الحقيقية.
# لا تضع القيم الحقيقية في هذا الملف أبدًا، ولا ترفع .env.local إلى Git.

# قاعدة Turso (إلزامي) — أنشئها: turso db create <name> ثم turso db show <name> --url
TURSO_DATABASE_URL=libsql://<db-name>-<org>.turso.io
TURSO_AUTH_TOKEN=<Turso token بصلاحيات كتابة>

# عنوان خدمة دمج الفيديو (إلزامي) — رابط النشر النهائي لمشروع merger-service
MERGER_API_BASE=https://your-merger-service.vercel.app

# اختياري: إن ضُبط يُطلب Bearer token للوصول إلى /mcp
MCP_ACCESS_TOKEN=

# اختياري: تجاوز أسماء الموديلات إن لزم
KIE_IMAGE_MODEL=
KIE_VIDEO_MODEL=
COMETAPI_IMAGE_MODEL=
COMETAPI_VIDEO_MODEL=
